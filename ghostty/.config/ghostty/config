command = fish --login --interactive

shell-integration = fish

theme = 0x96f

font-family  = "TX-02 Regular"
font-size    = 12
font-feature = -calt, -liga, -dlig
font-thicken = true

clipboard-trim-trailing-spaces = true

# Quick Terminal Settings
quick-terminal-position = top
quick-terminal-animation-duration = 0.1
quick-terminal-size = 30%,90%
quick-terminal-space-behavior = move
keybind = global:super+`=toggle_quick_terminal

# https://catskull.net/fun-with-ghostty-shaders.html
# custom-shader = ./shaders/cursor_blaze.glsl

# Include other configuration files
# Processing Order: The config-file keys are processed at the very END of the file.
# This means that even if you place config-file at the top of the main file,
# any overlapping settings inside the included files will overwrite the settings
# in the main config file.
config-file = ?keybinds.conf
config-file = ?macos-specific.conf
config-file = ?nix.conf
